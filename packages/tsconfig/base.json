{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolvePackageJsonExports": true,
    "declaration": true,
    "incremental": true,
    "sourceMap": true,
    "baseUrl": "./",
    "outDir": "./dist"
  }
}
