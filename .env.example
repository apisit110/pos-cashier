# docker compose variables — copy to .env (repo root)
# per-service runtime env is written inline in docker-compose.yml

# release version — pulls pos-cashier/<service>:RELEASE (built by Jenkins)
RELEASE=1.0.0

# x-origin-secret of the pos-sync-service Function URL (terraform var pos_sync_service_origin_secret)
SYNC_ORIGIN_SECRET=

# host ports
GATEWAY_PORT=3000
WEB_PORT=3008
