# docker compose variables — copy to .env (repo root)
# per-service runtime env is written inline in docker-compose.yml

# release version — images are tagged pos-cashier/<service>:RELEASE
RELEASE=1.0.0

# host ports
GATEWAY_PORT=3000
WEB_PORT=3008

# cashier-app build args (baked into the web bundle at build time)
# api url as seen from the browser
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# online | offline — should match APP_MODE in docker-compose.yml
NEXT_PUBLIC_APP_MODE=online
