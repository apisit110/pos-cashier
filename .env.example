# docker compose variables — copy to .env (repo root)

# release version — images are tagged <service>:RELEASE
RELEASE=1.0.0

# online | offline — offline seeds default staffs/terminal and disables sync to pos-center
APP_MODE=online

# merchant id from pos-center
MID=0001

# shared by every service — used to sign and verify staff JWTs
JWT_SECRET=change-me-same-value-in-every-service

# pos-sync-service (pos-center) — used when APP_MODE=online
SYNC_SERVICE_URL=http://host.docker.internal:4002
SYNC_PARTNER_ID=0001
SYNC_CLIENT_ID=your-sync-client-id
SYNC_CLIENT_SECRET=your-sync-client-secret
SYNC_TID=0001000101

# host ports
GATEWAY_PORT=3000
WEB_PORT=3008

# api url as seen from the browser (baked into the web bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
