{
  "name": "pos-cashier",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --concurrency 20",
    "dev:cashier": "turbo dev --filter=cashier-*",
    "dev:cashier:nogateway": "turbo dev --concurrency 20 --filter=cashier-app... --filter=cashier-authen-service... --filter=cashier-members-service... --filter=cashier-orders-service... --filter=cashier-products-service... --filter=cashier-sync-service... --filter=cashier-terminal-service... --filter=cashier-transactions-service...",
    "watch": "nodemon",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean-install": "find -E . -mindepth 1 -maxdepth 3 -type d -regex '.*(node_modules|dist|.turbo|.serverless|.next|.out)$' -exec rm -rf {} + && pnpm install",
    "clean-install:window": "find . -mindepth 1 -maxdepth 3 \\( -name \"node_modules\" -o -name \"dist\" -o -name \".turbo\" -o -name \".serverless\" -o -name \".next\" -o -name \".out\" \\) -type d -exec rm -rf {} + && pnpm install"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@10.3.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "dependencies": {
    "bullmq": "^5.76.6",
    "ioredis": "^5.10.1"
  }
}
