# online | offline — offline disables OutboxWorker (no sync attempts to pos-center)
APP_MODE=online

# must match JWT_SECRET in cashier-authen-service — used to verify staff JWTs
JWT_SECRET=change-me-same-value-in-every-service

# pos-sync-service (pos-center) — merchant credential of provider POS_CASHIER, used when APP_MODE=online
SYNC_SERVICE_URL=http://localhost:4002
SYNC_PARTNER_ID=0001
SYNC_CLIENT_ID=your-sync-client-id
SYNC_CLIENT_SECRET=your-sync-client-secret
SYNC_TID=0001000101
SYNC_ORIGIN_SECRET=
