MID="0001"
APP_MODE=online

# must match JWT_SECRET in every other service — used to sign and verify staff JWTs
JWT_SECRET=change-me-same-value-in-every-service

# pos-center is called by cashier-sync-service (BullMQ sync-queue): sync-staffs, and sync-pull after login
REDIS_HOST=localhost
REDIS_PORT=6379
